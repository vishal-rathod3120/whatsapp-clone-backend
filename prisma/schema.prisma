generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeviceType {
  ANDROID
  IOS
  WEB
  DESKTOP
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
}

enum ChatMemberRole {
  MEMBER
  ADMIN
  OWNER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
  POLL
}

enum MessageStatus {
  SENT
  DELIVERED
  SEEN
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ACCEPTED
  REJECTED
  MISSED
  ENDED
  FAILED
}

model User {
  id             String      @id @default(uuid())
  phoneNumber    String?     @unique
  email          String?     @unique
  username       String?     @unique
  displayName    String
  avatarUrl      String?
  aboutText      String?
  passwordHash   String?
  phoneHash      String?     @unique  // SHA-256 first 16 chars for contact discovery
  isVerified     Boolean     @default(false)
  failedLoginAttempts Int    @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  devices        Device[]
  createdChats   Chat[]      @relation("ChatCreator")
  memberships    ChatMember[]
  sentMessages   Message[]   @relation("MessageSender")
  attachments    Attachment[]
  blockedBy      UserBlock[] @relation("BlockedUser")
  blocking       UserBlock[] @relation("BlockerUser")
  initiatedCalls Call[]      @relation("CallInitiator")
  callParticipants CallParticipant[]
  messageReceipts  MessageReceipt[]
  deletedMessages  DeletedMessage[]
  statuses         Status[]
  messageReactions MessageReaction[]
  starredMessages  StarredMessage[]
  contacts       UserContact[]  @relation("UserContacts")
  contactedBy    UserContact[]  @relation("ContactUsers")
  scheduledMessages ScheduledMessage[] @relation("ScheduledUserMessages")
  createdCommunities Community[] @relation("CommunityCreator")
  communityMemberships CommunityMember[]

  @@map("users")
}

model Device {
  id               String     @id @default(uuid())
  userId           String
  deviceType       DeviceType
  deviceName       String?
  pushToken        String?
  refreshTokenHash String?
  publicKey        String?    // For E2EE - stores the device's X3DH identity key
  registrationId   Int?       // Added for E2EE
  isRevoked        Boolean    @default(false)
  lastActiveAt     DateTime?
  createdAt        DateTime   @default(now())

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  signedPreKeys    SignedPreKey[]
  oneTimePreKeys   OneTimePreKey[]
  sessions         Session[]

  @@index([userId])
  @@map("devices")
}

model Chat {
  id             String       @id @default(uuid())
  type           ChatType
  title          String?
  description    String?
  avatarUrl      String?
  createdById    String
  communityId    String?
  isAnnouncement Boolean      @default(false)
  lastMessageId  String?
  lastMessageAt  DateTime?
  disappearingTimer Int?       // Auto-delete timer in seconds (e.g., 86400)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  createdBy      User         @relation("ChatCreator", fields: [createdById], references: [id], onDelete: Restrict)
  community      Community?   @relation("CommunityChats", fields: [communityId], references: [id], onDelete: SetNull)
  members        ChatMember[]
  messages       Message[]
  calls          Call[]
  scheduledMessages ScheduledMessage[]

  @@index([createdById])
  @@index([lastMessageAt])
  @@map("chats")
}

model ChatMember {
  id                String         @id @default(uuid())
  chatId            String
  userId            String
  role              ChatMemberRole @default(MEMBER)
  joinedAt          DateTime       @default(now())
  leftAt            DateTime?
  isMuted           Boolean        @default(false)
  mutedUntil        DateTime?      // For 8 hrs, 1 week mutes
  isPinned          Boolean        @default(false)
  isArchived        Boolean        @default(false)
  wallpaperUrl      String?
  lastReadMessageId String?

  chat              Chat           @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id               String           @id @default(uuid())
  chatId           String
  senderId         String
  clientTempId     String?
  type             MessageType
  textContent      String?
  replyToMessageId String?
  attachmentId     String?
  status           MessageStatus    @default(SENT)
  isDeleted        Boolean          @default(false)
  isPinned         Boolean          @default(false)
  pinnedAt         DateTime?
  pinnedBy         String?
  isEncrypted      Boolean          @default(false)
  encryptionType   String?
  createdAt        DateTime         @default(now())
  editedAt         DateTime?
  expiresAt        DateTime?

  chat             Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender           User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachment       Attachment?      @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  replyToMessage   Message?         @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[]        @relation("MessageReplies")
  receipts         MessageReceipt[]
  deletedByUsers   DeletedMessage[]
  reactions        MessageReaction[]
  starredByUsers   StarredMessage[]
  poll             Poll?

  @@index([chatId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId])
  @@index([attachmentId])
  @@unique([senderId, clientTempId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageReceipt {
  id          String    @id @default(uuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  seenAt      DateTime?

  message      Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_receipts")
}

model DeletedMessage {
  id          String   @id @default(uuid())
  messageId   String
  userId      String
  deletedAt   DateTime @default(now())

  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("deleted_messages")
}

model Attachment {
  id              String    @id @default(uuid())
  uploaderId      String
  storageKey      String
  originalName    String?
  mimeType        String
  sizeBytes       BigInt
  width           Int?
  height          Int?
  durationSeconds Int?
  thumbnailKey    String?
  transcript      String?   // Added for Voice Transcriptions
  createdAt       DateTime  @default(now())

  uploader        User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  messages        Message[]
  scheduledMessages ScheduledMessage[]

  @@index([uploaderId])
  @@map("attachments")
}

model UserBlock {
  id         String   @id @default(uuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())

  blocker    User     @relation("BlockerUser", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked    User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Call {
  id          String            @id @default(uuid())
  chatId       String
  callerId     String
  type         CallType
  status       CallStatus
  startedAt    DateTime?
  answeredAt   DateTime?
  endedAt      DateTime?
  endReason    String?
  createdAt    DateTime          @default(now())

  chat         Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  caller       User              @relation("CallInitiator", fields: [callerId], references: [id], onDelete: Restrict)
  participants CallParticipant[]

  @@index([chatId])
  @@index([callerId])
  @@index([createdAt])
  @@map("calls")
}

model CallParticipant {
  id        String    @id @default(uuid())
  callId     String
  userId     String
  joinedAt   DateTime?
  leftAt     DateTime?

  call       Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([userId])
  @@map("call_participants")
}

model Status {
  id          String       @id @default(uuid())
  userId      String
  type        String       @default("TEXT") // TEXT or IMAGE
  textContent String?
  imageUrl    String?
  bgColor     String?      // Background color for text statuses
  caption     String?      // Caption for image statuses
  expiresAt   DateTime
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       StatusView[]

  @@index([userId])
  @@index([expiresAt])
  @@map("statuses")
}

model StatusView {
  id        String   @id @default(uuid())
  statusId  String
  viewerId  String
  viewedAt  DateTime @default(now())

  status    Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([viewerId])
  @@map("status_views")
}

model StarredMessage {
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@map("starred_messages")
}

// ===================== Contact Discovery =====================

model UserContact {
  id        String   @id @default(uuid())
  userId    String
  contactId String
  nickname  String?
  createdAt DateTime @default(now())

  user    User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("ContactUsers", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
  @@map("user_contacts")
}

model ContactSyncLog {
  id           String   @id @default(uuid())
  userId       String
  contactCount Int
  matchCount   Int
  syncedAt     DateTime @default(now())

  @@index([userId])
  @@index([syncedAt])
  @@map("contact_sync_logs")
}

// ===================== Security =====================

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // LOGIN_FAILED, LOGIN_SUCCESS, PASSWORD_CHANGED, ACCOUNT_LOCKED
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("security_logs")
}

// ===================== Polls =====================

model Poll {
  id         String       @id @default(uuid())
  messageId  String       @unique
  question   String
  isMultiple Boolean      @default(false)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())

  message    Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  options    PollOption[]

  @@map("polls")
}

model PollOption {
  id     String     @id @default(uuid())
  pollId String
  text   String
  order  Int        @default(0)

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  id       String   @id @default(uuid())
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@map("poll_votes")
}

// ===================== E2EE (Signal Protocol) =====================

model SignedPreKey {
  id          String   @id @default(uuid())
  deviceId    String
  keyId       Int
  publicKey   String   // base64 encoded
  signature   String   // Signature by identity key
  createdAt   DateTime @default(now())
  
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  @@unique([deviceId, keyId])
  @@index([deviceId])
  @@map("signed_prekeys")
}

model OneTimePreKey {
  id          String   @id @default(uuid())
  deviceId    String
  keyId       Int
  publicKey   String   // base64 encoded
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  @@unique([deviceId, keyId])
  @@index([deviceId, isUsed])
  @@map("one_time_prekeys")
}

model Session {
  id                String   @id @default(uuid())
  deviceId          String   // Our device
  remoteUserId      String   // Other party's user ID
  remoteDeviceId    String   // Other party's device ID
  
  // Double Ratchet state (encrypted at rest)
  sessionState      String   // JSON blob of DR state, encrypted
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  @@unique([deviceId, remoteUserId, remoteDeviceId])
  @@index([deviceId])
  @@map("sessions")
}

enum ScheduledMessageStatus {
  PENDING
  SENT
  CANCELLED
}

model ScheduledMessage {
  id               String                 @id @default(uuid())
  userId           String
  chatId           String
  textContent      String?
  attachmentId     String?
  type             MessageType            @default(TEXT)
  status           ScheduledMessageStatus @default(PENDING)
  scheduledAt      DateTime
  createdAt        DateTime               @default(now())

  user             User                   @relation("ScheduledUserMessages", fields: [userId], references: [id], onDelete: Cascade)
  chat             Chat                   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  attachment       Attachment?            @relation(fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([chatId])
  @@index([scheduledAt, status])
  @@map("scheduled_messages")
}

model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatarUrl   String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User     @relation("CommunityCreator", fields: [createdById], references: [id])
  chats       Chat[]   @relation("CommunityChats")
  members     CommunityMember[]

  @@index([createdById])
  @@map("communities")
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        ChatMemberRole @default(MEMBER)
  joinedAt    DateTime @default(now())

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}
